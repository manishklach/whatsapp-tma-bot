PORT=3000
NODE_ENV=development

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string
WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=replace-with-your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v26.0

# Redis session and idempotency storage
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=604800

# Optional external PDF generator. Leave blank to use the built-in generator.
# The endpoint receives multipart/form-data with `payload` JSON and uploaded files.
PDF_API_URL=
PDF_API_TOKEN=
PDF_API_TIMEOUT_MS=30000
# Comma-separated parent domains or exact hosts allowed for JSON downloadUrl responses.
PDF_API_DOWNLOAD_ALLOWLIST=
