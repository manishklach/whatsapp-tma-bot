{
  "name": "whatsapp-tma-bot",
  "version": "1.0.0",
  "private": false,
  "description": "A production-oriented WhatsApp intake bot for collecting Form TM-A data and generating PDFs.",
  "repository": {
    "type": "git",
    "url": "https://github.com/manishklach/whatsapp-tma-bot.git"
  },
  "homepage": "https://github.com/manishklach/whatsapp-tma-bot#readme",
  "bugs": "https://github.com/manishklach/whatsapp-tma-bot/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bullmq": "^6.3.2",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "pdfkit": "^0.16.0",
    "redis": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.13.8",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
